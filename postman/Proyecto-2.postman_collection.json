      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Atencion incluida sin recursion\",()=>{const h=pm.response.json();pm.expect(h.atenciones).to.have.length(1);pm.expect(h.atenciones[0]).not.to.have.property(\"historiaClinica\");});"
            ]
