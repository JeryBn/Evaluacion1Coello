        "body": {
          "mode": "raw",
          "raw": "{\n  \"activo\": true\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Registrar usuario",
