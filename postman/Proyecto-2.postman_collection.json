{
  "info": {
    "name": "Proyecto 2 - Integracion Historia Clinica",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Solo datos ficticios. Ejecutar en orden. Configurar claves locales en entorno, nunca subirlas. CSRF activo, autenticar Basic y mantener cookies."
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "admin"
      },
      {
        "key": "password",
        "value": "{{adminPassword}}"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "medicoPassword",
      "value": ""
    },
    {
      "key": "recepcionPassword",
      "value": ""
    },
    {
      "key": "demoUserPassword",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (![\"GET\",\"HEAD\",\"OPTIONS\"].includes(pm.request.method) && !pm.info.requestName.includes(\"sin CSRF\")) {",
          "pm.sendRequest({url:pm.variables.get(\"baseUrl\")+\"/api/csrf\",method:\"GET\",header:{Authorization:\"Basic \"+btoa(\"admin:\"+pm.variables.get(\"adminPassword\"))}},(err,res)=>{if(err)throw err;const token=res.json();pm.request.headers.upsert({key:token.headerName,value:token.token});});",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Roles disponibles",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/admin/roles"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"medicoRolId\",pm.response.json().find(r=>r.codigo===\"MEDICO\").id);pm.collectionVariables.set(\"runId\",Date.now().toString());"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Registrar rol",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/admin/roles",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codigo\": \"DEMO_{{runId}}\",\n  \"nombre\": \"Rol demostracion\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"rolId\",pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Editar rol",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/admin/roles/{{rolId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Rol editado\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Desactivar rol",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/admin/roles/{{rolId}}/estado",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"activo\": false\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Activar rol",
